{
  "permissions": {
    "allow": [
      "Bash(./scripts/arch-test)",
      "Bash(./scripts/arch.js)",
      "Bash(./scripts/check)",
      "Bash(./scripts/dev:*)",
      "Bash(./scripts/dupes-test)",
      "Bash(./scripts/dupes.js)",
      "Bash(./scripts/format)",
      "Bash(./scripts/setup)",
      "Bash(./scripts/test:*)"
    ],
    "deny": [
      "Bash(op read:*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.staging)",
      "Read(.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.*.local)"
    ]
  },
  "enabledPlugins": {
    "tsgo-lsp@endless-ambiance-local": true
  },
  "extraKnownMarketplaces": {
    "endless-ambiance-local": {
      "source": {
        "source": "directory",
        "path": "./.claude/plugins"
      }
    }
  }
}
