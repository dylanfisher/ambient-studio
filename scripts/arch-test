#!/usr/bin/env bash
# Runs scripts/arch.js on two fixture trees: one it must pass, and one with each kind of broken
# tier rule planted once, which it must report file by file. A checker that has never been seen
# failing passes an empty or broken tree just as happily as a clean one.
set -uo pipefail
cd "$(dirname "$0")/.."

base=$(mktemp -d)
trap 'rm -rf "$base"' EXIT
problems=0

# write <path> — the file's text comes from standard input.
write() { mkdir -p "$(dirname "$1")"; cat > "$1"; }

good="$base/good"
write "$good/src/engine/voice.js" <<'JS'
import { seed } from "./seed.js";
export const voice = seed;
JS
write "$good/src/engine/seed.js" <<<'export const seed = 1;'
write "$good/src/domain/lint.js" <<<'import { voice } from "../engine/voice.js";'
write "$good/src/config/config.js" <<'JS'
import { readFileSync } from "node:fs";
import { env } from "node:process";
export const file = process.env.AMBIENT_STUDIO_CONFIG ?? process["env"].HOME;
JS
write "$good/src/server/main.js" <<'JS'
import { createServer } from "node:http";
import { lint } from "../domain/lint.js";
import { config } from "../config/config.js";
const later = await import("../engine/voice.js");
JS
write "$good/src/server/omlx-queue.js" <<'JS'
import { request } from "node:http";
export const ask = () => fetch("http://127.0.0.1:8000/v1/chat/completions");
JS
write "$good/src/server/listen.js" <<'JS'
import http, { createServer } from "node:http";
export const servers = [http.createServer(), createServer()];
JS
write "$good/src/web/app.js" <<'JS'
export { lint } from "../domain/lint.js";
export const vibes = () => fetch("/api/vibes");
JS
write "$good/src/server/clock.js" <<<'export const now = () => Date.now() + Math.random();'

if ! out=$(node scripts/arch.js --root "$good" 2>&1); then
  printf 'arch-test: the good tree failed:\n%s\n' "$out" >&2
  problems=$((problems + 1))
fi

bad="$base/bad"
write "$bad/src/engine/up.js" <<<'import { lint } from "../domain/lint.js";'
write "$bad/src/engine/reexport.js" <<<'export { main } from "../server/main.js";'
write "$bad/src/domain/lint.js" <<<'import { readFileSync } from "node:fs";'
write "$bad/src/domain/package.js" <<<'import _ from "lodash";'
write "$bad/src/server/main.js" <<<'import { app } from "../web/app.js";'
write "$bad/src/web/app.js" <<<'const config = await import("../config/config.js");'
write "$bad/src/config/config.js" <<<'import { seed } from "../engine/seed.js";'
write "$bad/src/stray/thing.js" <<<'export const thing = 1;'
write "$bad/src/engine/noise.js" <<'JS'
const seed = 1;
export const noise = () => Math.random() * seed;
JS
write "$bad/src/engine/clock.js" <<<'export const now = Date.now();'
write "$bad/src/server/port.js" <<'JS'
const fallback = 1;
export const port = Number(process.env.PORT);
JS
write "$bad/src/server/home.js" <<<'export const home = process["env"].HOME;'
write "$bad/src/server/destructured.js" <<<'const { env } = process;'
write "$bad/src/server/optional.js" <<<'export const home = process?.env.HOME;'
write "$bad/src/server/env.js" <<<'import { argv, env } from "node:process";'
write "$bad/src/server/client.js" <<'JS'
const url = "http://127.0.0.1:8000/v1/models";
export const models = await fetch(url);
JS
write "$bad/src/server/get.js" <<<'import { get } from "node:https";'
write "$bad/src/server/send.js" <<<'import http, { request as send } from "node:http";'
write "$bad/src/server/raw.js" <<'JS'
import * as http from "node:http";
export const ask = () => http.request("http://127.0.0.1:8000/v1/models");
JS
write "$bad/src/config/probe.js" <<<'export const probe = () => globalThis.fetch("http://127.0.0.1:8000");'
write "$bad/src/server/later.js" <<'JS'
const ready = true;
export const http = await import("node:https");
JS
write "$bad/src/server/socket.js" <<<'import { connect } from "node:net";'
write "$bad/src/server/h2.js" <<<'export const h2 = await import("http2");'
write "$bad/src/server/omlx-queue.js" <<<'import { request } from "undici";'

out=$(node scripts/arch.js --root "$bad" 2>&1)
status=$?
if [ "$status" != 1 ]; then
  printf 'arch-test: the bad tree exited %s, expected 1:\n%s\n' "$status" "$out" >&2
  problems=$((problems + 1))
fi
for want in \
  'src/engine/up.js: engine may not import domain ("../domain/lint.js")' \
  'src/engine/reexport.js: engine may not import server ("../server/main.js")' \
  'src/domain/lint.js: imports "node:fs"; domain runs in the browser unbundled' \
  'src/domain/package.js: imports "lodash"; domain runs in the browser unbundled' \
  'src/server/main.js: server may not import web ("../web/app.js")' \
  'src/web/app.js: web may not import config ("../config/config.js")' \
  'src/config/config.js: config may not import engine ("../engine/seed.js")' \
  'src/stray/thing.js: not inside a tier' \
  'src/engine/noise.js:2: uses Math.random; the engine draws only from its seeded PRNG' \
  'src/engine/clock.js:1: uses Date.now; the engine draws only from its seeded PRNG' \
  'src/server/port.js:2: reads process.env; only src/config reads the environment' \
  'src/server/home.js:1: reads process.env; only src/config reads the environment' \
  'src/server/destructured.js:1: reads process.env; only src/config reads the environment' \
  'src/server/optional.js:1: reads process.env; only src/config reads the environment' \
  'src/server/env.js:1: reads process.env; only src/config reads the environment' \
  'src/server/client.js:2: calls fetch; only src/server/omlx-queue.js sends HTTP requests (0022)' \
  'src/server/get.js:1: imports get from node:http; only src/server/omlx-queue.js sends HTTP requests (0022)' \
  'src/server/send.js:1: imports request from node:http; only src/server/omlx-queue.js sends HTTP requests (0022)' \
  'src/server/raw.js:2: calls http.request; only src/server/omlx-queue.js sends HTTP requests (0022)' \
  'src/config/probe.js:1: calls fetch; only src/server/omlx-queue.js sends HTTP requests (0022)' \
  'src/server/later.js:2: imports node:https dynamically; only src/server/omlx-queue.js sends HTTP requests (0022)' \
  'src/server/socket.js:1: imports node:net; only src/server/omlx-queue.js sends HTTP requests (0022)' \
  'src/server/h2.js:1: imports http2; only src/server/omlx-queue.js sends HTTP requests (0022)' \
  'src/server/omlx-queue.js:1: imports undici; only src/server/omlx-queue.js sends HTTP requests (0022)'; do
  if ! grep -qF -- "$want" <<<"$out"; then
    printf 'arch-test: no finding\n  %s\nin:\n%s\n' "$want" "$out" >&2
    problems=$((problems + 1))
  fi
done

out=$(node scripts/arch.js --root 2>&1)
status=$?
if [ "$status" != 2 ] || [ "$out" != "arch: --root needs a directory" ]; then
  printf 'arch-test: --root without a value exited %s:\n%s\n' "$status" "$out" >&2
  problems=$((problems + 1))
fi

[ "$problems" = 0 ] && echo "arch passes the clean tree and reports each planted import"
exit "$problems"
