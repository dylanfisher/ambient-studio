#!/usr/bin/env bash
# Run the studio locally. The ONE place the run command is written down — AGENTS.md and
# README point here rather than repeating it. Passes through any extra args, so
# `./scripts/dev --port 4000` works without editing this file. The app has no secrets;
# settings come from the config file that src/config/ reads.
set -euo pipefail
cd "$(dirname "$0")/.."

exec node --watch src/server/main.js "$@"
