#!/usr/bin/env bash
# Run the studio locally. The ONE place the run command is written down — AGENTS.md and
# README point here rather than repeating it. The app has no secrets; settings, the host
# and port included, come from the config file that src/config/ reads
# ($AMBIENT_STUDIO_CONFIG picks another one), and main.js refuses arguments.
set -euo pipefail
cd "$(dirname "$0")/.."

exec node --watch src/server/main.js "$@"
